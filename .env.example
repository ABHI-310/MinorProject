# SQLite is the zero-setup default. To use PostgreSQL, set this environment variable:
# DATABASE_URL=postgresql+psycopg://pcb:pcb_dev_only@localhost:5432/pcb_maintenance
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PCB_DEVICE=cpu
# Example local launch (environment variables must be exported or passed with --env-file):
# .venv/bin/uvicorn backend.main:app --app-dir src --env-file .env --host 127.0.0.1 --port 8000
